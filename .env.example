# PostgreSQL connection string for the app and Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_app?schema=public"

# Generate with: npx auth secret
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# SMTP is required to deliver password reset links. In development without SMTP,
# links are logged to the server console only.
EMAIL_FROM="Finance App <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
